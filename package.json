{
  "name": "dsh-android-ui",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的 Android/移动端界面适配模块：viewport(含 interactive-widget/安全区)、移动端 CSS、启动前 polyfill（AbortSignal.any / crypto.randomUUID）与运行时 DOM 效果（软键盘跟随、触摸气泡、enterkeyhint、下拉吸附）。从 deepseek-harness-android 的 apply-frontend.sh 注入方案改写为官方插件形态。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/smoke.mjs",
    "check": "npm run build && npm test",
    "manifest": "node scripts/manifest-standalone.mjs",
    "prepack": "node build.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "mobile",
    "android",
    "termux",
    "viewport",
    "polyfill"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
